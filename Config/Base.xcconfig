// Statusphere target settings shared by every build configuration.
//
// To sign with your own Apple Developer team, do not edit this file.
// Copy Local.xcconfig.example to Local.xcconfig (ignored by git) and
// override the values there.

// The bundle ID is $(BUNDLE_ID_PREFIX).Statusphere. Change the prefix if the
// default ID is already registered by another team.
BUNDLE_ID_PREFIX = com.nnabeyang
PRODUCT_BUNDLE_IDENTIFIER = $(BUNDLE_ID_PREFIX).Statusphere

// Empty so the app runs in the simulator without an Apple ID.
DEVELOPMENT_TEAM =
CODE_SIGN_STYLE = Manual

// Mac Catalyst builds need a team unless they are signed to run locally.
CODE_SIGN_IDENTITY[sdk=macosx*] = -

// The server that hosts the OAuth client metadata at
// https://$(STATUSPHERE_OAUTH_HOST)/statusphere/client-metadata.json.
// Info.plist passes it to the app as StatusphereOAuthHost.
STATUSPHERE_OAUTH_HOST = soyokaze.nnabeyang.com
INFOPLIST_FILE = Config/Info.plist

#include? "Local.xcconfig"
